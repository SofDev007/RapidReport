# Copy this file to .env and fill in your values
SECRET_KEY=change-this-to-a-long-random-string

# Supabase connection string - Project Settings > Database > Connection string > Session pooler
# URL-encode special characters in the password (e.g. & -> %26, / -> %2F, ^ -> %5E)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres

# Seeded on first startup if no user with this email exists yet.
# If ADMIN_PASSWORD is left unset, a random password is generated and printed once on startup.
ADMIN_EMAIL=admin@rapidreport.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Gmail SMTP credentials for report escalation emails to police stations.
# EMAIL_APP_PASSWORD is a Google "App Password" (not your normal Gmail password) -
# create one at https://myaccount.google.com/apppasswords with 2FA enabled.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Supabase Storage (evidence file uploads) - Project Settings > API
# SUPABASE_URL is https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY is the "service_role" secret key (server-side only, never expose to clients)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
